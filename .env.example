# ── App ──────────────────────────────────────────────────────────────
APP_NAME="NovaExtract AI"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ── Database (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/novaextract_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/novaextract_db

# ── IA (Groq / OpenAI Compatible) ────────────────────────────────────
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=llama-3.3-70b-versatile
